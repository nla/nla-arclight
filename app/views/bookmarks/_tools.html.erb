<% if @bookmarks.present? %>
  <div class="bookmarksTools d-flex flex-wrap gap-2">
    <div class="dropdown flex-shrink-0">
      <button class="btn btn-primary dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <%= t("cite_all.title") %>
      </button>
      <ul class="dropdown-menu">
        <% CitationHelper::CITATION_FORMATS.each do |style, label| %>
          <li><%= link_to t(label), cite_all_bookmarks_path(style: style), class: "dropdown-item", data: { blacklight_modal: "trigger", turbo: false } %></li>
        <% end %>
      </ul>
    </div>
    <div class="dropdown flex-shrink-0">
      <button class="btn btn-outline-primary dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <%= t("blacklight.bookmarks.export_all") %>
      </button>
      <ul class="dropdown-menu">
        <li><%= link_to t("blacklight.bookmarks.export_csv"), export_bookmarks_path(format: "csv"), class: "dropdown-item" %></li>
        <li><%= link_to t("blacklight.bookmarks.export_ris"), export_bookmarks_path(format: "ris"), class: "dropdown-item" %></li>
      </ul>
    </div>
  </div>
<% end %>
