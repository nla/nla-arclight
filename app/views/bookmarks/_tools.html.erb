<% if @bookmarks.present? %>
  <div class="bookmarksTools d-flex flex-wrap gap-2">
    <a class="btn btn-primary" data-blacklight-modal="trigger" data-turbo="false" href="<%= cite_all_bookmarks_path %>">
      <%= t("cite_all.title") %>
    </a>
    <a class="btn btn-outline-primary" href="<%= export_bookmarks_path(format: "csv") %>">
      <%= t("blacklight.bookmarks.export_all") %>
    </a>
  </div>
<% end %>
